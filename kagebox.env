# Kagebox configuration — sourced by ./kagebox
# Edit these to taste, then re-run `./kagebox setup` (idempotent).

# --- VM (multipass) ---
VM_NAME=hermes
VM_CPUS=4
VM_MEM=4G
VM_DISK=20G
VM_IMAGE=24.04            # Ubuntu LTS image for the sandbox (a moving alias —
                          # the image actually used is recorded in
                          # hermes-state/provenance.txt at provision time)

# Pin the Hermes installer (#17). Provisioning downloads the install script,
# prints its sha256, and — if this is set — refuses to run it on a mismatch.
# Leave empty to stay unpinned; `./kagebox provision` tells you the value to
# paste here. Pinning means an upstream change is something you review rather
# than something you silently receive.
HERMES_INSTALLER_SHA256=

# --- Network policy ---
# Which egress profile the sandbox runs under (see vm/profiles/):
#   sealed    bridge only — for untrusted input; `task` mode forces this
#   research  search, wikis, papers, news  [default]
#   dev       research + package registries (pypi/npm/crates/go, github)
#   open      no allowlist at all — the VM has the whole internet
# Your own vm/egress-allowlist.txt is layered ON TOP of whichever is active.
# Switch with: ./kagebox egress profile <name>
EGRESS_PROFILE=research

# --- Bridge (host <-> VM) ---
BRIDGE_PORT=18080
BRIDGE_IFACE=mpqemubr0    # host interface multipass creates for the VM network

# Model used by the /claude route (host `claude -p`): sonnet | opus | haiku.
# Billed to your host Claude account. sonnet balances cost/quality; haiku is cheapest.
CLAUDE_BRIDGE_MODEL=sonnet

# Model for the /gemini route (cloud research brain). Free-tier friendly flash
# models: gemini-flash-latest, gemini-2.5-flash. Pro (stronger, lower free quota):
# gemini-2.5-pro. `./kagebox backend gemini` uses this.
GEMINI_MODEL=gemini-flash-latest

# --- Model served through the bridge to Hermes ---
# A large-context wrapper is built from the base model so Hermes has room to work.
# NOTE: the base model MUST support tools (Hermes is a tool-using agent).
# Tool-capable local models you have: granite4, qwen2.5:3b, qwen-tax, functiongemma.
# gemma3 does NOT support tools — don't use it as a Hermes backend.
HERMES_BASE_MODEL=LiquidAI/lfm2.5-1.2b-instruct
HERMES_MODEL_NAME=hermes-ctx
# Hermes Agent enforces a 64K minimum context. lfm2 has a small KV cache, so 64K
# still fits the iGPU comfortably (unlike granite4, whose 64K KV overcommitted).
HERMES_NUM_CTX=65536

# GPU layers for the Hermes model. This host's AMD GPU has only 8 GB VRAM; a big
# model overcommits it -> amdgpu reset -> the GPU terminal (Ghostty) dies.
#   0     = CPU/RAM only (safe for large models like granite4/lfm2.5-8.5B)
#   empty = auto (Ollama puts it on GPU). Safe ONLY for small models that fit in
#           VRAM with headroom — e.g. lfm2.5-1.2b (~1.5 GB) leaves ~5 GB free.
# lfm2.5-1.2b is small enough to run fully on the GPU, so we leave this empty.
HERMES_NUM_GPU=

# --- Shared workspace ---
# The ONLY host directory exposed to the sandbox (mounted read-write at
# /home/ubuntu/workspace in the VM). Leave empty to share nothing at all.
SHARE_DIR=workspace

# Host folder for Hermes' memory/state backups (mounted to ~/hermes-state in the
# VM). Auto-backed-up every 10 min + on `./kagebox down`, and restored on
# rebuild — so memory survives a VM crash/corruption/rebuild.
STATE_DIR=hermes-state
