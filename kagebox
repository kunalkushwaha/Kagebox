#!/usr/bin/env bash
# kagebox — manage the Hermes-in-a-microVM sandbox.
#
#   ./kagebox doctor      preflight-check host prerequisites (KVM, multipass, …)
#   ./kagebox setup       one-time build: multipass + bridge + model + VM + Hermes
#   ./kagebox up          start the VM and the bridge
#   ./kagebox down        stop the VM and the bridge
#   ./kagebox status      show VM + bridge + Ollama status
#   ./kagebox shell       open a shell in the sandbox (then type: hermes)
#   ./kagebox bridge ...  start | stop | status | log | install
#   ./kagebox model       (re)build the large-context Ollama model
#   ./kagebox provision    (re)install/configure Hermes inside the VM
#   ./kagebox claude      install Claude Code in the sandbox, wired to the bridge
#   ./kagebox backend ... point Hermes at a backend: ollama | claude | <cloud provider>
#   ./kagebox providers   list backends + cloud AI providers (bridge/providers.json)
#   ./kagebox telegram    set up a Telegram bot to chat with Hermes from your phone
#   ./kagebox gateway ... manage the messaging gateway (status|start|stop|restart|run)
#   ./kagebox backup      snapshot Hermes memory/state to the host (survives VM loss)
#   ./kagebox restore     restore Hermes memory/state from the host backup
#   ./kagebox egress ...  host-enforced egress allowlist for the VM (on|off|status|refresh)
#   ./kagebox verify      assert the sandbox boundary from inside the VM (fail-closed)
#   ./kagebox audit       review the sandbox's bridge API-call log
#   ./kagebox usage       token/cost usage per provider (from the bridge)
#   ./kagebox snapshot [name] · snapshots · rollback <name>   VM point-in-time snapshots
#   ./kagebox task "<prompt>"  run a one-off task in a throwaway, egress-contained clone
#   ./kagebox destroy     delete the VM and stop the bridge (near-zero residue)
#   ./kagebox help        show this command list
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$HERE"
# shellcheck disable=SC1091
source "$HERE/kagebox.env"

msg() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

UNIT_DIR="$HOME/.config/systemd/user"

have() { command -v "$1" >/dev/null 2>&1; }

# ---------------------------------------------------------------- multipass ---
ensure_multipass() {
  if have multipass; then return; fi
  msg "Installing multipass (needs sudo, one time)..."
  sudo snap install multipass || die "multipass install failed"
}

# ------------------------------------------------------------------- model ---
build_model() {
  have ollama || { warn "ollama CLI not found on host — skipping model build"; return; }
  msg "Building '${HERMES_MODEL_NAME}' from '${HERMES_BASE_MODEL}' (num_ctx=${HERMES_NUM_CTX}, num_gpu=${HERMES_NUM_GPU:-auto})"
  {
    printf 'FROM %s\nPARAMETER num_ctx %s\n' "$HERMES_BASE_MODEL" "$HERMES_NUM_CTX"
    [ -n "${HERMES_NUM_GPU:-}" ] && printf 'PARAMETER num_gpu %s\n' "$HERMES_NUM_GPU"
  } > "$HERE/bridge/Modelfile.hermes"
  if ! ollama list 2>/dev/null | grep -q "^${HERMES_BASE_MODEL%%:*}"; then
    warn "base model '${HERMES_BASE_MODEL}' not pulled; run: ollama pull ${HERMES_BASE_MODEL}"
  fi
  ollama create "$HERMES_MODEL_NAME" -f "$HERE/bridge/Modelfile.hermes" \
    && msg "model '${HERMES_MODEL_NAME}' ready" \
    || warn "ollama create failed (you can still use a stock model name in kagebox.env)"
}

# ------------------------------------------------------------------ bridge ---
bridge_install() {
  mkdir -p "$UNIT_DIR"
  sed -e "s/BRIDGE_PORT=18080/BRIDGE_PORT=${BRIDGE_PORT}/" \
      -e "s/BRIDGE_IFACE=mpqemubr0/BRIDGE_IFACE=${BRIDGE_IFACE}/" \
      -e "s/CLAUDE_BRIDGE_MODEL=sonnet/CLAUDE_BRIDGE_MODEL=${CLAUDE_BRIDGE_MODEL:-sonnet}/" \
      -e "s|__KAGEBOX_DIR__|${HERE}|g" \
      "$HERE/bridge/kagebox-bridge.service" > "$UNIT_DIR/kagebox-bridge.service"
  systemctl --user daemon-reload
  msg "bridge service installed at $UNIT_DIR/kagebox-bridge.service"
}
bridge_start() {
  [ -f "$UNIT_DIR/kagebox-bridge.service" ] || bridge_install
  systemctl --user enable --now kagebox-bridge.service
  sleep 1
  systemctl --user --no-pager -l status kagebox-bridge.service | sed -n '1,6p' || true
}
bridge_stop() { systemctl --user disable --now kagebox-bridge.service 2>/dev/null || true; }
bridge_status() { systemctl --user --no-pager -l status kagebox-bridge.service 2>/dev/null | sed -n '1,8p' || echo "bridge not installed"; }
bridge_log() { journalctl --user -u kagebox-bridge.service -n "${1:-40}" --no-pager 2>/dev/null || echo "no logs"; }

bridge_ip() { ip -4 -o addr show dev "$BRIDGE_IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1; }

# --------------------------------------------------------------------- vm ---
vm_exists() { multipass info "$VM_NAME" >/dev/null 2>&1; }
vm_launch() {
  if vm_exists; then msg "VM '$VM_NAME' already exists"; return; fi
  msg "Launching sandbox VM '$VM_NAME' (${VM_CPUS} cpu / ${VM_MEM} / ${VM_DISK})..."
  multipass launch "$VM_IMAGE" --name "$VM_NAME" \
    --cpus "$VM_CPUS" --memory "$VM_MEM" --disk "$VM_DISK" \
    --cloud-init "$HERE/vm/cloud-init.yaml" --timeout 900
  ensure_mount
}

# (Re)establish the workspace mount if it's missing — multipass mounts can drop
# across stop/start, so this is idempotent and called from launch + up.
_mount_one() {
  local host="$1" guest="$2"
  [ -n "$host" ] || return 0
  mkdir -p "$HERE/$host"
  multipass info "$VM_NAME" 2>/dev/null | grep -q "=> $guest" && return 0
  msg "Mounting $HERE/$host -> $VM_NAME:$guest"
  multipass mount "$HERE/$host" "$VM_NAME:$guest" || warn "mount $host failed (non-fatal)"
}
ensure_mount() {
  vm_exists || return 0
  _mount_one "${SHARE_DIR:-}" "/home/ubuntu/workspace"    # deliverables (host window)
  _mount_one "${STATE_DIR:-hermes-state}" "/home/ubuntu/hermes-state"  # memory backups
}

cmd_backup() {
  vm_exists || die "no VM"
  ensure_mount
  multipass transfer "$HERE/vm/backup-state.sh" "$VM_NAME:/home/ubuntu/backup-state.sh" 2>/dev/null || true
  multipass exec "$VM_NAME" -- bash /home/ubuntu/backup-state.sh
}
cmd_restore() {
  vm_exists || die "no VM"
  ensure_mount
  multipass transfer "$HERE/vm/restore-state.sh" "$VM_NAME:/home/ubuntu/restore-state.sh" 2>/dev/null || true
  multipass exec "$VM_NAME" -- bash /home/ubuntu/restore-state.sh
  warn "restart Hermes to load restored state (e.g. ./kagebox gateway restart, or start a new session)"
}
vm_provision() {
  vm_exists || die "VM '$VM_NAME' does not exist; run: ./kagebox setup"
  ensure_mount
  msg "Provisioning Hermes inside '$VM_NAME'..."
  multipass transfer "$HERE/vm/provision.sh"     "$VM_NAME:/home/ubuntu/provision.sh"
  multipass transfer "$HERE/vm/backup-state.sh"  "$VM_NAME:/home/ubuntu/backup-state.sh"
  multipass transfer "$HERE/vm/restore-state.sh" "$VM_NAME:/home/ubuntu/restore-state.sh"
  multipass exec "$VM_NAME" -- \
    env BRIDGE_PORT="$BRIDGE_PORT" HERMES_MODEL="$HERMES_MODEL_NAME" HERMES_NUM_CTX="$HERMES_NUM_CTX" \
    bash /home/ubuntu/provision.sh
}

vm_backend() {
  vm_exists || die "VM '$VM_NAME' does not exist; run: ./kagebox setup"
  local b="${1:-}" route model ctx provider="custom"
  case "$b" in
    ollama) route="/v1";        model="$HERMES_MODEL_NAME";            ctx="$HERMES_NUM_CTX" ;;
    claude) route="/claude/v1"; model="${CLAUDE_BRIDGE_MODEL:-sonnet}"; ctx=200000 ;;
    "") die "usage: ./kagebox backend {ollama|claude|<provider>}   (list: ./kagebox providers)" ;;
    *)  # any provider defined in bridge/providers.json
      local spec
      spec=$(python3 - "$HERE/bridge/providers.json" "$b" <<'PY'
import json, os, sys
try:
    cfg = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(2)
p = (cfg.get("providers") or {}).get(sys.argv[2])
if not p:
    sys.exit(3)
env_model = os.environ.get(sys.argv[2].upper().replace("-", "_") + "_MODEL")
print(p.get("bridge_path", "/v1"))
print(env_model or p.get("model", ""))
print(p.get("context_length", 65536))
print(p.get("hermes_provider", "custom"))
PY
) || die "unknown backend '$b' — add it to bridge/providers.json (see: ./kagebox providers)"
      { read -r route; read -r model; read -r ctx; read -r provider; } <<<"$spec" ;;
  esac
  msg "Pointing Hermes at the '${b}' backend (provider ${provider}, ${route}, model ${model})..."
  multipass exec "$VM_NAME" -- env ROUTE="$route" MODEL="$model" PORT="$BRIDGE_PORT" CTX="$ctx" PROVIDER="$provider" bash -lc '
    GW=$(ip route | awk "/^default/{print \$3; exit}")
    BASE="http://${GW}:${PORT}${ROUTE}"
    mkdir -p ~/.hermes
    cat > ~/.hermes/config.yaml <<EOF
# Managed by kagebox backend.
model:
  provider: ${PROVIDER}     # Hermes provider (custom = any OpenAI-compatible endpoint)
  base_url: "${BASE}"
  default: "${MODEL}"
  context_length: ${CTX}
EOF
    touch ~/.hermes/.env; chmod 600 ~/.hermes/.env
    grep -v -E "^(OPENAI_BASE_URL|OPENAI_API_KEY)=" ~/.hermes/.env > ~/.hermes/.env.tmp 2>/dev/null || true
    mv ~/.hermes/.env.tmp ~/.hermes/.env 2>/dev/null || true
    { echo "OPENAI_BASE_URL=${BASE}"; echo "OPENAI_API_KEY=bridge"; } >> ~/.hermes/.env
    chmod 600 ~/.hermes/.env
    echo "Hermes backend -> ${BASE} (model ${MODEL}, ctx ${CTX})"
  '
}

vm_claude_setup() {
  vm_exists || die "VM '$VM_NAME' does not exist; run: ./kagebox setup"
  if [ ! -f "$HERE/bridge/secrets.env" ] || ! grep -q ANTHROPIC_API_KEY "$HERE/bridge/secrets.env" 2>/dev/null; then
    warn "No ANTHROPIC_API_KEY in bridge/secrets.env — 'claude -p' will 502 until you add it:"
    warn "  cp bridge/secrets.env.example bridge/secrets.env && \$EDITOR bridge/secrets.env && ./kagebox bridge start"
  fi
  msg "Installing Claude Code inside '$VM_NAME' and wiring it to the bridge..."
  multipass transfer "$HERE/vm/claude-setup.sh" "$VM_NAME:/home/ubuntu/claude-setup.sh"
  multipass exec "$VM_NAME" -- env BRIDGE_PORT="$BRIDGE_PORT" bash /home/ubuntu/claude-setup.sh
}

# ---------------------------------------------------------------- verify ---
verify() {
  vm_exists || die "no VM (run ./kagebox setup)"
  multipass info "$VM_NAME" 2>/dev/null | grep -q Running || { msg "starting $VM_NAME..."; multipass start "$VM_NAME"; ensure_mount; bridge_start >/dev/null 2>&1; }
  msg "Verifying the sandbox boundary from INSIDE the VM (every control here fails open, so we assert, not assume)..."
  # Runs entirely in the guest. Core invariants FAIL the run if broken; egress
  # posture is probed and reported (open is a valid config until you contain it).
  multipass exec "$VM_NAME" -- env KBOX_PORT="$BRIDGE_PORT" bash -s <<'GUEST'
set -u
export PATH="$HOME/.local/bin:$PATH"   # non-login shell: include where hermes installs
PORT="${KBOX_PORT:-18080}"
GW=$(ip route | awk '/^default/{print $3; exit}')
B="http://$GW:$PORT"
ok=0; fail=0; info=0
pass(){ printf '  \033[0;32m[ok]\033[0m   %s\n' "$1"; ok=$((ok+1)); }
bad(){  printf '  \033[0;31m[FAIL]\033[0m %s\n' "$1"; fail=$((fail+1)); }
note(){ printf '  \033[0;33m[info]\033[0m %s\n' "$1"; info=$((info+1)); }

# 1. sandbox -> bridge -> Ollama path works
code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 6 "$B/api/version")
[ "$code" = 200 ] && pass "bridge reachable ($B -> Ollama /api/version = 200)" \
                   || bad "bridge NOT reachable ($B/api/version = $code)"

# 2. the bridge refuses ALL Ollama model-management endpoints (Batch A)
admin_bad=""
for ep in delete pull push create copy; do
  c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 6 -X POST -d '{}' "$B/api/$ep")
  [ "$c" = 403 ] || admin_bad="$admin_bad /api/$ep=$c"
done
[ -z "$admin_bad" ] && pass "admin endpoints blocked at the bridge (delete/pull/push/create/copy = 403)" \
                    || bad "admin endpoint(s) NOT blocked:$admin_bad (want 403)"

# 3. raw Ollama not directly reachable from the guest (loopback-only on host).
#    Fail CLOSED: use the known-open bridge port as a positive control for the
#    /dev/tcp probe method — if the control can't connect, the probe is broken
#    and we report FAIL, never a silent pass.
probe(){ timeout 3 bash -c "exec 3<>/dev/tcp/$1/$2" 2>/dev/null; }
if [ -z "$GW" ]; then bad "no default route in guest — cannot probe the boundary"
elif ! probe "$GW" "$PORT"; then bad "boundary probe is broken (can't reach known-open bridge $GW:$PORT) — raw-Ollama check inconclusive, treated as FAIL"
elif probe "$GW" 11434; then bad "raw Ollama reachable at $GW:11434 — should be bridge-only"
else pass "raw Ollama not directly reachable ($GW:11434 refused)"; fi

# 4. no host LLM credentials leaked into the guest environment (name- OR value-based)
if env | grep -qiE '(_API_KEY|_AUTH_TOKEN)=.|=(sk-ant-|sk-|aiza)'; then
  bad "a host API key/token appears in the guest environment"
else pass "no host LLM API keys/tokens in the guest environment"; fi

# 5. no host auth artefacts leaked into the guest
hits=$(ls -d "$HOME"/.claude.json "$HOME"/.claude/.credentials.json "$HOME"/.config/claude \
              "$HOME"/.netrc "$HOME"/.aws/credentials 2>/dev/null | tr '\n' ' ')
[ -z "$hits" ] && pass "no host auth artefacts (claude/netrc/aws) in the guest" \
               || bad "host auth artefact(s) present in the guest: $hits"

# 6. egress posture — probe a non-allowlisted destination BY IP (bypasses DNS).
#    Distinguish "blocked" (curl rc 7 refused / 28 timeout) from "probe broke".
if ! command -v curl >/dev/null 2>&1; then note "egress posture unknown (curl missing)"
else
  out=$(curl -s -o /dev/null -w '%{http_code}' --max-time 6 https://1.1.1.1 2>/dev/null); rc=$?
  if [ "$rc" = 0 ] && [ "$out" != 000 ]; then
    note "egress OPEN — direct internet reachable (1.1.1.1 = $out); run './kagebox egress on' for untrusted work"
  elif [ "$rc" = 7 ] || [ "$rc" = 28 ]; then
    pass "egress CONTAINED — direct internet (1.1.1.1) blocked (curl rc=$rc)"
  else note "egress posture inconclusive (curl rc=$rc)"; fi
fi

# 7. DNS still resolves (needed in both postures)
getent hosts example.com >/dev/null 2>&1 && pass "DNS resolves (example.com)" \
                                          || note "DNS did not resolve example.com"

# 8. the agent itself is installed
command -v hermes >/dev/null 2>&1 && pass "hermes binary present" || note "hermes not found in PATH"

printf '\n  Summary: %d ok · %d info · %d FAIL\n' "$ok" "$info" "$fail"
[ "$fail" -eq 0 ]
GUEST
}

# ----------------------------------------------------------------- flows ---
cmd_setup() {
  ensure_multipass
  build_model
  vm_launch
  bridge_start
  vm_provision
  # Contained by default: provisioning above needed open internet; now lock the
  # finished sandbox down to the (host-enforced) allowlist before the closing
  # verify, so that check reflects the final posture. The allowlist starts empty
  # = bridge-only, the tightest posture; add domains you trust to
  # vm/egress-allowlist.txt. Non-fatal — the sandbox is usable either way.
  msg "enabling host-enforced egress — contained by default (needs sudo)..."
  cmd_egress on || warn "egress not enabled (sudo declined?) — run ./kagebox egress on when ready"
  verify
  cat <<EOF

$(printf '\033[1;32m✓ Sandbox ready.\033[0m')  (egress: contained — allowlist in vm/egress-allowlist.txt)
  Enter it:     ./kagebox shell     (then type: hermes)
  Verify:       ./kagebox verify     ·  Open egress: ./kagebox egress off
  Status:       ./kagebox status
  Tear it down: ./kagebox destroy
EOF
}
cmd_up() { ensure_multipass; vm_exists && multipass start "$VM_NAME" || warn "VM missing; run setup"; ensure_mount; bridge_start; }
cmd_down() { vm_exists && cmd_backup 2>/dev/null || true; multipass stop "$VM_NAME" 2>/dev/null || true; bridge_stop; }
cmd_status() {
  echo "== VM =="; multipass info "$VM_NAME" 2>/dev/null | sed -n '1,10p' || echo "no VM"
  echo; echo "== bridge =="; bridge_status; echo "bridge IP: $(bridge_ip 2>/dev/null || echo n/a):${BRIDGE_PORT}"
  echo; echo "== host ollama =="; curl -s --max-time 3 http://127.0.0.1:11434/api/version || echo "ollama not answering"
}
cmd_shell() { multipass shell "$VM_NAME"; }
cmd_destroy() {
  read -rp "Delete VM '$VM_NAME' and stop the bridge? [y/N] " a
  [ "${a:-n}" = y ] || { echo "aborted"; exit 0; }
  multipass delete --purge "$VM_NAME" 2>/dev/null || true
  bridge_stop
  msg "Sandbox destroyed. Host residue: multipass snap + these files (remove with: sudo snap remove multipass)."
}

cmd_egress() {
  # Host-enforced egress (nftables on the host, keyed on the bridge iface) so a
  # root agent in the VM cannot remove it. Needs sudo; works whether or not the
  # VM is running. The in-guest vm/egress-apply.sh remains only as defence-in-depth.
  local action="${1:-status}"
  [ "$action" = status ] || msg "egress $action — host-enforced on '$BRIDGE_IFACE' (needs sudo; the guest cannot alter this)"
  sudo BRIDGE_IFACE="$BRIDGE_IFACE" BRIDGE_PORT="$BRIDGE_PORT" \
       EGRESS_ALLOWFILE="$HERE/vm/egress-allowlist.txt" \
       bash "$HERE/bridge/host-egress.sh" "$action"
}

cmd_audit() {
  local f="$HERE/audit/bridge.jsonl" n="${1:-20}"
  [ -f "$f" ] || { echo "no audit log yet at $f (make a request through the bridge first)"; return 0; }
  echo "Bridge API-call audit — last $n of $(wc -l < "$f") lines:"
  tail -n "$n" "$f" | python3 -c '
import sys, json, datetime
for line in sys.stdin:
    try: e = json.loads(line)
    except Exception: continue
    ts = datetime.datetime.fromtimestamp(e.get("ts", 0), datetime.timezone.utc).strftime("%H:%M:%S")
    print("  %s  %-5s %-46s -> %s" % (ts, e.get("method",""), e.get("path","")[:46], e.get("status","")))'
  echo "  (agent shell/sessions: ~/.hermes/logs & sessions in the VM, in ${STATE_DIR:-hermes-state}/ backups)"
}

cmd_doctor() {
  local ok=0 warn=0 fail=0
  pass()  { printf '  \033[0;32m[ok]\033[0m   %s\n' "$1"; ok=$((ok+1)); }
  warnf() { printf '  \033[0;33m[warn]\033[0m %s\n' "$1"; warn=$((warn+1)); }
  failf() { printf '  \033[0;31m[fail]\033[0m %s\n' "$1"; fail=$((fail+1)); }
  echo "Preflight — Kagebox host checks:"
  [ -e /dev/kvm ] && pass "KVM: /dev/kvm present" || failf "KVM: /dev/kvm missing (hardware virtualization required)"
  command -v multipass >/dev/null 2>&1 && pass "multipass: $(multipass version 2>/dev/null | head -1)" || failf "multipass not installed  (sudo snap install multipass)"
  command -v python3 >/dev/null 2>&1 && pass "python3 present (bridge dependency)" || failf "python3 missing"
  if curl -s --max-time 3 http://127.0.0.1:11434/api/version >/dev/null 2>&1; then pass "Ollama reachable on 127.0.0.1:11434"; else warnf "Ollama not reachable (only needed for the local backend)"; fi
  local free_gb; free_gb=$(df -Pk "$HERE" 2>/dev/null | awk 'NR==2{print int($4/1024/1024)}')
  [ "${free_gb:-0}" -ge 15 ] && pass "disk: ${free_gb} GB free" || warnf "disk: only ${free_gb:-?} GB free (>=15 GB recommended)"
  if journalctl -u ollama --no-pager 2>/dev/null | grep -q "OLLAMA_IGPU_ENABLE:1"; then pass "Ollama iGPU enabled"
  elif journalctl -u ollama --no-pager 2>/dev/null | grep -q "dropping integrated GPU"; then warnf "Ollama is dropping the integrated GPU (set OLLAMA_IGPU_ENABLE=1 to use it)"; fi
  if vm_exists; then pass "VM '$VM_NAME': $(multipass info "$VM_NAME" 2>/dev/null | awk '/State/{print $2}')"; else warnf "VM '$VM_NAME' not built yet (./kagebox setup)"; fi
  [ "$(systemctl --user is-active kagebox-bridge.service 2>/dev/null)" = active ] && pass "bridge service active" || warnf "bridge not running (./kagebox bridge start)"
  # Egress posture — surface it so "contained" is never silently assumed. The
  # cron marker is host-enforced and world-readable, so no sudo is needed here.
  if [ -f /etc/cron.d/kagebox-egress ]; then pass "egress: contained (host-enforced allowlist ON) — verify with ./kagebox verify"
  else warnf "egress: OPEN — the VM has full internet; run ./kagebox egress on for untrusted work"; fi
  if [ -f "$HERE/${STATE_DIR:-hermes-state}/.last-backup" ]; then pass "memory backup present ($(cat "$HERE/${STATE_DIR:-hermes-state}/.last-backup"))"; else warnf "no memory backup yet (auto every 10 min once running)"; fi
  echo; printf 'Summary: %d ok · %d warn · %d fail\n' "$ok" "$warn" "$fail"
  [ "$fail" -eq 0 ]
}

cmd_providers() {
  echo "Backends for './kagebox backend <name>':"
  echo "  ollama   local model (${HERMES_MODEL_NAME}) on the iGPU/CPU"
  echo "  claude   host 'claude -p' (no key; your host Claude auth; text-only, no tool-calling)"
  echo
  echo "Cloud providers from bridge/providers.json  (key -> bridge/secrets.env, kept host-side):"
  python3 - "$HERE/bridge/providers.json" "$HERE/bridge/secrets.env" <<'PY'
import json, sys
try:
    cfg = json.load(open(sys.argv[1]))
except Exception:
    print("  (no/invalid providers.json)"); sys.exit()
try:
    secrets = open(sys.argv[2]).read()
except Exception:
    secrets = ""
def keyset(env):
    if not env:
        return True
    for line in secrets.splitlines():
        line = line.strip()
        if line.startswith(env + "=") and line.split("=", 1)[1].strip():
            return True
    return False
for name, p in (cfg.get("providers") or {}).items():
    env = p.get("auth_env", "")
    status = "ready" if keyset(env) else "NEEDS KEY: " + env
    print(f"  {name:12} model={str(p.get('model','?')):26} [{status}]")
PY
  echo
  echo "Add a provider: edit bridge/providers.json + put its key in bridge/secrets.env, then:"
  echo "  ./kagebox bridge start && ./kagebox backend <name>"
}

cmd_gateway() {
  vm_exists || die "VM not up; run ./kagebox up"
  multipass exec "$VM_NAME" -- bash -lc "export XDG_RUNTIME_DIR=/run/user/\$(id -u); hermes gateway ${*:-status}"
}

cmd_telegram() {
  vm_exists || die "VM not up; run ./kagebox up"
  cat <<'INTRO'
Telegram gateway setup. First, in the Telegram app:
  1. Message @BotFather   -> /newbot -> copy the BOT TOKEN (like 123456:ABC-...)
  2. Message @userinfobot -> copy your numeric USER ID
INTRO
  local TG_TOKEN TG_USERS
  read -rsp "Paste the Telegram BOT TOKEN: " TG_TOKEN; echo
  read -rp  "Your Telegram user ID(s), comma-separated (allowlist): " TG_USERS
  [ -n "$TG_TOKEN" ] && [ -n "$TG_USERS" ] || die "both the token and your user id are required"
  msg "Configuring + starting the Telegram gateway inside '$VM_NAME'..."
  # token travels via stdin (a pipe), never in argv/process-list/history
  printf 'TELEGRAM_BOT_TOKEN=%s\nTELEGRAM_ALLOWED_USERS=%s\n' "$TG_TOKEN" "$TG_USERS" \
    | multipass exec "$VM_NAME" -- bash -lc '
        umask 077
        new=$(cat)
        touch ~/.hermes/.env
        grep -vE "^(TELEGRAM_BOT_TOKEN|TELEGRAM_ALLOWED_USERS)=" ~/.hermes/.env > ~/.hermes/.env.new || true
        printf "%s\n" "$new" >> ~/.hermes/.env.new
        mv ~/.hermes/.env.new ~/.hermes/.env
        chmod 600 ~/.hermes/.env
        echo "Saved token + allowlist to ~/.hermes/.env (deny-all except your ID)."
        export XDG_RUNTIME_DIR=/run/user/$(id -u)
        # boot-time system service is most robust for a headless VM (sudo is passwordless here);
        # fall back to a user service if --system is unavailable.
        sudo hermes gateway install --system 2>&1 | tail -8 \
          || hermes gateway install 2>&1 | tail -8 || true
        hermes gateway start 2>&1 | tail -4 || sudo hermes gateway start 2>&1 | tail -4 || true
        echo "--- status ---"; hermes gateway status 2>&1 | tail -15 || true
      '
  msg "Message your bot on Telegram. Manage it with: ./kagebox gateway {status|restart|stop|run}"
}

cmd_snapshot() {
  vm_exists || die "no VM"
  local name="${1:-}" running=0
  multipass info "$VM_NAME" 2>/dev/null | grep -q "Running" && running=1
  [ "$running" = 1 ] && { msg "stopping VM to snapshot (multipass needs it stopped)..."; multipass stop "$VM_NAME"; }
  if [ -n "$name" ]; then multipass snapshot "$VM_NAME" --name "$name"; else multipass snapshot "$VM_NAME"; fi
  if [ "$running" = 1 ]; then multipass start "$VM_NAME"; ensure_mount; bridge_start >/dev/null 2>&1; fi
  msg "snapshot saved. list: ./kagebox snapshots"
}
cmd_snapshots() { multipass list --snapshots 2>/dev/null || multipass info "$VM_NAME" --snapshots 2>/dev/null; }
cmd_rollback() {
  vm_exists || die "no VM"
  local snap="${1:-}"; [ -n "$snap" ] || die "usage: ./kagebox rollback <snapshot>   (see: ./kagebox snapshots)"
  read -rp "Restore '$VM_NAME' to snapshot '$snap'? Current disk state is LOST. [y/N] " a
  [ "${a:-n}" = y ] || { echo aborted; return 0; }
  multipass stop "$VM_NAME" 2>/dev/null || true
  multipass restore "${VM_NAME}.${snap}" --destructive
  multipass start "$VM_NAME"; ensure_mount; bridge_start >/dev/null 2>&1
  msg "rolled back to '$snap'."
}

cmd_usage() {
  local f="$HERE/audit/usage.jsonl"
  [ -f "$f" ] || { echo "no usage logged yet at $f (make a cloud/claude call first)"; return 0; }
  python3 - "$f" <<'PY'
import sys, json, collections
# rough USD per 1M tokens (input, output) — APPROXIMATE, edit freely. Local ollama = free.
PRICES = {"gemini": (0.075, 0.30), "openrouter": (1.0, 3.0),
          "anthropic": (3.0, 15.0), "claude": (3.0, 15.0), "ollama": (0.0, 0.0)}
agg = collections.defaultdict(lambda: [0, 0, 0])
for line in open(sys.argv[1]):
    try: e = json.loads(line)
    except Exception: continue
    k = (e.get("route", "?"), e.get("model", "?"))
    agg[k][0] += e.get("prompt_tokens", 0); agg[k][1] += e.get("completion_tokens", 0); agg[k][2] += 1
print("%-11s %-26s %6s %10s %10s %8s" % ("route", "model", "calls", "in_tok", "out_tok", "~USD"))
ti = to = tc = 0
for (route, model), (i, o, c) in sorted(agg.items()):
    pin, pout = PRICES.get(route, (0, 0)); cost = i/1e6*pin + o/1e6*pout
    ti += i; to += o; tc += cost
    print("%-11s %-26s %6d %10d %10d %8.3f" % (route, model[:26], c, i, o, cost))
print("-" * 74)
print("%-11s %-26s %6s %10d %10d %8.3f" % ("TOTAL", "", "", ti, to, tc))
print("(prices approximate — edit PRICES in ./kagebox; streamed calls without usage aren't counted)")
PY
}

cmd_task() {
  vm_exists || die "run ./kagebox setup first (need a provisioned VM to clone)"
  local prompt="${*:-}"; [ -n "$prompt" ] || die "usage: ./kagebox task \"<prompt>\""
  local clone="${VM_NAME}-task"
  multipass delete --purge "$clone" 2>/dev/null || true
  local running=0; multipass info "$VM_NAME" 2>/dev/null | grep -q "Running" && running=1
  [ "$running" = 1 ] && { msg "stopping $VM_NAME briefly (clone needs it stopped)..."; multipass stop "$VM_NAME"; }
  msg "cloning $VM_NAME -> $clone (throwaway)..."
  multipass clone "$VM_NAME" --name "$clone" || die "clone failed (needs multipass >= 1.15)"
  if [ "$running" = 1 ]; then multipass start "$VM_NAME" >/dev/null 2>&1; ensure_mount; bridge_start >/dev/null 2>&1; fi
  multipass start "$clone"
  [ -n "${SHARE_DIR:-}" ] && multipass mount "$HERE/$SHARE_DIR" "$clone:/home/ubuntu/workspace" 2>/dev/null || true
  # Contain the throwaway with the HOST-enforced allowlist — the clone shares the
  # bridge, so the host table covers it, and its root agent cannot remove it
  # (the in-guest egress-apply.sh below is only defence-in-depth). Host egress is
  # interface-wide, so this contains every VM on the bridge for the run; it is
  # left ON afterwards (the safe direction) — reopen with `./kagebox egress off`.
  msg "containing the throwaway (host-enforced egress; needs sudo)..."
  cmd_egress on >/dev/null || warn "host egress could not be enabled — the throwaway is only guest-contained (removable by its root agent)"
  multipass transfer "$HERE/vm/egress-apply.sh" "$clone:/home/ubuntu/egress-apply.sh" 2>/dev/null || true
  multipass transfer "$HERE/vm/egress-allowlist.txt" "$clone:/home/ubuntu/egress-allowlist.txt" 2>/dev/null || true
  multipass exec "$clone" -- bash /home/ubuntu/egress-apply.sh on >/dev/null 2>&1 || true
  printf '%s' "$prompt" | multipass exec "$clone" -- bash -c 'cat > ~/task.txt'
  msg "running task in $clone (egress-contained; output -> workspace/)..."
  multipass exec "$clone" -- bash -lc 'cd ~/workspace 2>/dev/null; export XDG_RUNTIME_DIR=/run/user/$(id -u); hermes -z "$(cat ~/task.txt)" --yolo' 2>&1 | tail -25
  msg "destroying throwaway $clone."
  multipass delete --purge "$clone"
  warn "host egress was left ON (host-enforced; contains ALL VMs on '$BRIDGE_IFACE', including $VM_NAME). Reopen with: ./kagebox egress off"
}

case "${1:-}" in
  setup) cmd_setup ;;
  doctor) cmd_doctor ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  snapshots) cmd_snapshots ;;
  rollback) shift; cmd_rollback "$@" ;;
  usage) cmd_usage ;;
  task) shift; cmd_task "$@" ;;
  providers|backends) cmd_providers ;;
  telegram) cmd_telegram ;;
  gateway) shift; cmd_gateway "$@" ;;
  backup) cmd_backup ;;
  restore) cmd_restore ;;
  egress) shift; cmd_egress "$@" ;;
  audit) shift; cmd_audit "$@" ;;
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  shell) cmd_shell ;;
  model) build_model ;;
  provision) vm_provision; verify ;;
  claude) vm_claude_setup ;;
  backend) vm_backend "${2:-}" ;;
  verify) verify ;;
  destroy) cmd_destroy ;;
  bridge)
    case "${2:-status}" in
      start) bridge_start ;; stop) bridge_stop ;; install) bridge_install ;;
      status) bridge_status ;; log) bridge_log "${3:-40}" ;;
      *) echo "usage: kagebox bridge {start|stop|status|log|install}" ;;
    esac ;;
  ""|help|-h|--help)
    awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$HERE/kagebox" ;;
  *) die "unknown command '$1' (try: ./kagebox help)" ;;
esac
