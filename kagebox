            return True
    return False
for name, p in (cfg.get("providers") or {}).items():
    env = p.get("auth_env", "")
    status = "ready" if keyset(env) else "NEEDS KEY: " + env
    print(f"  {name:12} model={str(p.get('model','?')):26} [{status}]")
PY
  echo
  echo "Add a provider: edit bridge/providers.json + put its key in bridge/secrets.env, then:"
  echo "  ./kagebox bridge start && ./kagebox backend <name>"
}

cmd_gateway() {
  vm_exists || die "VM not up; run ./kagebox up"
  multipass exec "$VM_NAME" -- bash -lc "export XDG_RUNTIME_DIR=/run/user/\$(id -u); hermes gateway ${*:-status}"
}

# Install/manage Hermes skills. Skills come from open-ended, CDN-fronted
# registries (skills.sh, GitHub, ClawHub, PyPI/npm for their deps) — exactly the
# hosts an IP allowlist cannot pin reliably (rotating CDN IPs) and cannot
# enumerate (any registry, any repo). So instead of poking permanent holes in
# the allowlist, we open the door for the duration of a *fetch*, then re-seal —
# a deliberate, user-initiated window, re-sealed even on Ctrl-C.
cmd_skills() {
  vm_exists || die "run ./kagebox setup first (need the sandbox VM)"
  multipass info "$VM_NAME" 2>/dev/null | grep -q Running \
    || { msg "starting $VM_NAME..."; multipass start "$VM_NAME"; ensure_mount; bridge_start >/dev/null 2>&1; }
  [ "$#" -eq 0 ] && set -- list
  # Ops that only touch already-installed skills need no network — don't open
  # the door (or ask for sudo) for those.
  local need_net=1
  case "$1" in
    list|config|uninstall|reset|opt-in|opt-out|list-modified|diff) need_net=0 ;;
    # `hermes skills` has no `help` subcommand — translate it rather than
    # passing it through to an argparse error.
    help|-h|--help) need_net=0; set -- --help ;;
  esac
  local was_contained=0; [ -f /etc/cron.d/kagebox-egress ] && was_contained=1
  local opened=0
  reseal() {
    [ "$opened" = 1 ] || return 0
    opened=0
    msg "re-sealing egress (back to contained)..."
    # keep stderr: if the sudo timestamp expired during a long install, the
    # password prompt must be visible rather than swallowed into a silent hang.
    cmd_egress on >/dev/null || warn "FAILED to re-seal egress — run './kagebox egress on' NOW to re-contain."
  }
  if [ "$need_net" = 1 ] && [ "$was_contained" = 1 ]; then
    warn "'$1' fetches from CDN-fronted skill/package registries an IP allowlist can't cover. Opening egress for this operation only — the VM has full internet until it finishes, then it re-seals."
    trap 'reseal' EXIT INT TERM
    cmd_egress off >/dev/null || die "could not open egress (sudo declined?) — a skill fetch needs network; nothing changed."
    opened=1
  fi
  msg "hermes skills $* (in $VM_NAME)"
  multipass exec "$VM_NAME" -- bash -lc 'export XDG_RUNTIME_DIR=/run/user/$(id -u); hermes skills "$@"' kagebox-skills "$@"
  local rc=$?
  reseal
  trap - EXIT INT TERM
  return "$rc"
}

# Run a web-enabled research/search task in a bounded window. Internet search
# that reads arbitrary pages genuinely needs broad egress (fetching any page IS
# egress), so rather than punch a permanent hole this OPENS the VM's internet
# for one run and RE-SEALS after — re-sealed even on Ctrl-C. A best-effort
# content filter (a family DNS resolver that blocks adult/malware) applies
# during the window. That filter is HYGIENE, not containment: a denylist fails
# open and cannot stop a determined exfil — which is why the door still closes
# again afterward. Untrusted input? Prefer `./kagebox task` (throwaway clone).
cmd_research() {
  vm_exists || die "run ./kagebox setup first (need the sandbox VM)"
  multipass info "$VM_NAME" 2>/dev/null | grep -q Running \
    || { msg "starting $VM_NAME..."; multipass start "$VM_NAME"; ensure_mount; bridge_start >/dev/null 2>&1; }
  local prompt="$*"
  [ -n "$prompt" ] || die "usage: ./kagebox research \"<what to search / research>\""
  # Cloudflare for Families (adult + malware) by default. Override with
  # KAGEBOX_FILTER_DNS="9.9.9.9 …", or KAGEBOX_FILTER_DNS="" to disable it.
  local filter_dns="${KAGEBOX_FILTER_DNS-1.1.1.3 1.0.0.3}"
  local was_contained=0; [ -f /etc/cron.d/kagebox-egress ] && was_contained=1
  local opened=0 filtered=0
  restore() {
    if [ "$filtered" = 1 ]; then filtered=0
      multipass exec "$VM_NAME" -- bash -lc 'ifc=$(ip route|awk "/^default/{print \$5;exit}"); sudo resolvectl revert "$ifc"' >/dev/null 2>&1 || true
    fi
    if [ "$opened" = 1 ]; then opened=0; msg "re-sealing egress (back to contained)..."
      cmd_egress on >/dev/null || warn "FAILED to re-seal egress — run './kagebox egress on' NOW to re-contain."
    fi
  }
  trap 'restore' EXIT INT TERM
  # 1. open the door for the run
  if [ "$was_contained" = 1 ]; then
    warn "opening the VM's internet for this run — the WHOLE VM (agent + any gateway) can reach the web until it finishes, then it re-seals. A bounded window, not containment."
    cmd_egress off >/dev/null || die "could not open egress (sudo declined?) — nothing changed."
    opened=1
  fi
  # 2. best-effort content filter (hygiene, NOT security — DNS-based, bypassable)
  if [ -n "$filter_dns" ]; then
    if multipass exec "$VM_NAME" -- bash -lc "ifc=\$(ip route|awk '/^default/{print \$5;exit}'); sudo resolvectl dns \"\$ifc\" $filter_dns" >/dev/null 2>&1; then
      filtered=1; msg "content filter ON — DNS -> $filter_dns (blocks adult/malware; best-effort hygiene)"
    else warn "could not apply the content-filter DNS — continuing without it"; fi
  fi
  # 3. run the agent task with web access; output lands in the shared workspace
  msg "researching (web open$([ "$filtered" = 1 ] && echo ", filtered")): $prompt"
  multipass exec "$VM_NAME" -- bash -lc 'cd ~/workspace 2>/dev/null; export XDG_RUNTIME_DIR=/run/user/$(id -u); hermes -z "$1" --yolo' kagebox-research "$prompt" 2>&1 | tail -40
  # 4. restore posture (revert DNS, re-seal)
  restore
  trap - EXIT INT TERM
}

# --- egress warden: the sandbox asks, you approve, the window closes itself ---
# `research` opens the door from a terminal with your sudo, which is useless
# from a phone. The warden is the phone-shaped version: the VM can REQUEST a
# window over the bridge, the request reaches you on Telegram, and only your
# tap opens it — for a bounded number of seconds, after which it re-seals.
#
# The approval bot MUST be a different bot from the one running inside the VM.
# The in-VM bot's token lives in the sandbox; if the sandbox is compromised it
# controls that conversation and could answer for you. This token stays on the
# host, in a root-only file, and never enters the VM.
WARDEN_CONF="/etc/kagebox/warden.env"
WARDEN_UNIT="/etc/systemd/system/kagebox-warden.service"

warden_setup() {
  command -v systemctl >/dev/null 2>&1 || die "systemd required for the warden"
  cat <<'INTRO'

  Kagebox egress warden — setup
  =============================
  This lets the sandbox ASK for internet access and lets YOU approve it from
  your phone. The window is time-boxed and re-seals automatically.

  You need a SECOND Telegram bot, separate from the one in the VM:
    1. Message @BotFather -> /newbot  (name it e.g. "kagebox warden")
    2. Copy the token it gives you.
  Why separate: the in-VM bot's token sits inside the sandbox. If the sandbox
  is ever compromised it holds that credential — so it must not be the one
  guarding the door. This token stays on the host, readable only by root.

INTRO
  local tok users
  printf 'Warden bot token (input hidden): '; read -rs tok; echo
  [ -n "$tok" ] || die "no token given — nothing written"
  case "$tok" in [0-9]*:?*) ;; *) die "that does not look like a bot token (expected 123456:ABC-...)" ;; esac
  printf 'Your numeric Telegram user id (comma-separated for several): '; read -r users
  [ -n "$users" ] || die "no approver id given — a warden with no approvers denies everything"
  case "$users" in *[!0-9,\ ]*) die "user ids must be numeric (get yours from @userinfobot)" ;; esac

  msg "writing $WARDEN_CONF (root-only)..."
  sudo install -d -m 0755 /etc/kagebox || die "could not create /etc/kagebox"
  # Written via stdin so the token never appears in the process list or history.
  printf 'WARDEN_BOT_TOKEN=%s\nWARDEN_ALLOWED_USERS=%s\nWARDEN_SOCK_GROUP=%s\n' \
    "$tok" "${users// /}" "$(id -gn)" \
    | sudo tee "$WARDEN_CONF" >/dev/null || die "could not write $WARDEN_CONF"
  sudo chmod 0600 "$WARDEN_CONF"; sudo chown root:root "$WARDEN_CONF"

  msg "installing the warden service..."
  sed -e "s|__KAGEBOX_DIR__|${HERE}|g" "$HERE/bridge/kagebox-warden.service" \
    | sudo tee "$WARDEN_UNIT" >/dev/null || die "could not write $WARDEN_UNIT"
  sudo systemctl daemon-reload
  sudo systemctl enable --now kagebox-warden.service || die "warden failed to start (see: ./kagebox warden log)"
  sleep 1
  # The gateway needs the new /egress/request route and the socket path.
  bridge_restart >/dev/null 2>&1 || true
  warden_install_helper
  msg "warden ready — the sandbox can now ask; only your tap opens the door."
  warden_status
}

# Drop the asking-tool inside the VM. This is the guest's whole vocabulary for
# the request: it can ask, and it can be told no.
warden_install_helper() {
  vm_exists || return 0
  local gw; gw="$(bridge_ip)"
  [ -n "$gw" ] || return 0
  multipass exec "$VM_NAME" -- env GW="$gw" PORT="$BRIDGE_PORT" bash -lc '
    sudo tee /usr/local/bin/kagebox-web >/dev/null <<EOF
#!/usr/bin/env bash
# Ask the host for a time-boxed window to specific destinations. The host
# decides; you cannot. Name the hosts you need — a vague ask is refused, and
# only an explicit --all requests the (much bigger) whole-VM window.
#
# usage: kagebox-web [-t SECS] <host[:ports]> [host...] -- "<why>"
#        kagebox-web --all -t 60 -- "<why>"
set -u
SECS=60; DESTS=(); REASON=""; ALL=0
while [ \$# -gt 0 ]; do
  case "\$1" in
    -t|--seconds) SECS="\${2:-60}"; shift 2 ;;
    --all)        ALL=1; shift ;;
    --)           shift; REASON="\$*"; break ;;
    *)            DESTS+=("\$1"); shift ;;
  esac
done
[ -n "\$REASON" ] || REASON="web access"
if [ "\$ALL" = 0 ] && [ \${#DESTS[@]} -eq 0 ]; then
  echo "usage: kagebox-web [-t SECS] <host[:ports]>... -- \"<why>\"" >&2
  echo "   eg: kagebox-web -t 60 duckduckgo.com:443 -- \"web search for the user\"" >&2
  exit 2
fi
echo "asking the host for \${SECS}s -> \${DESTS[*]:-ALL} (waiting for approval)..." >&2
python3 - "\$SECS" "\$REASON" "\$ALL" "\${DESTS[@]:-}" <<PY
import json,sys,urllib.request
secs,reason,allflag=sys.argv[1],sys.argv[2],sys.argv[3]
dests=[d for d in sys.argv[4:] if d]
body={"seconds":int(secs),"reason":reason,"destinations":dests}
if allflag=="1": body["scope"]="all"
req=urllib.request.Request("http://${GW}:${PORT}/egress/request",
    data=json.dumps(body).encode(), headers={"content-type":"application/json"})
try:
    r=json.loads(urllib.request.urlopen(req,timeout=480).read().decode())
except Exception as e:
    print("request failed (denied):",e); sys.exit(1)
print(("GRANTED: " if r.get("granted") else "DENIED: ")+str(r.get("detail","")))
sys.exit(0 if r.get("granted") else 1)
PY
EOF
    sudo chmod 0755 /usr/local/bin/kagebox-web' >/dev/null 2>&1 \
    && msg "installed 'kagebox-web' inside the VM (the agent's way to ask)" \
    || warn "could not install the in-VM helper (is the VM running?)"
  # A tool the agent does not know about is a tool it will not use. Ship the
  # instructions with the binary: this skill tells it when to ask, to name the
  # hosts, and that a denial is an answer rather than something to retry.
  if [ -f "$HERE/skills/request-web/SKILL.md" ]; then
    multipass exec "$VM_NAME" -- bash -lc 'mkdir -p ~/.hermes/skills/request-web && cat > ~/.hermes/skills/request-web/SKILL.md' \
      < "$HERE/skills/request-web/SKILL.md" 2>/dev/null \
      && msg "installed the 'request-web' skill (teaches the agent to ask)" \
      || warn "could not install the request-web skill"
  fi
}

warden_status() {
  if [ ! -f "$WARDEN_UNIT" ]; then echo "warden: NOT installed (./kagebox warden setup)"; return; fi
  systemctl --no-pager -l status kagebox-warden.service 2>/dev/null | sed -n '1,6p' || true
  if [ -f /run/kagebox/window-open ]; then
    warn "a window is OPEN right now: $(cat /run/kagebox/window-open 2>/dev/null)"
  else
    echo "no window open (VM is sealed unless you also ran 'egress off')"
  fi
}

cmd_warden() {
  case "${1:-status}" in
    setup|install) warden_setup ;;
    status) warden_status ;;
    log) journalctl -u kagebox-warden.service -n "${2:-40}" --no-pager 2>/dev/null || echo "no logs" ;;
    helper) warden_install_helper ;;
    stop)   sudo systemctl disable --now kagebox-warden.service ;;
    *) echo "usage: kagebox warden {setup|status|log|helper|stop}" ;;
  esac
}

# --- autostart: survive logout and reboot ------------------------------------
# Three things have to outlive your terminal, and they persist differently:
#   * the VM        — owned by multipassd (a snap SYSTEM service), so it is
#                     already independent of any shell; it just needs starting
#                     again after a host reboot.
#   * the bridge    — a systemd --user service. Immune to closing a terminal,
#                     but WITHOUT linger it is killed at logout and does not
#                     come back until you log in. `autostart on` enables linger.
#   * the warden    — a root SYSTEM service; already survives both.
# Inside the VM, the Hermes gateway is a --user service with linger already on,
# so the bot comes back whenever the VM boots.
cmd_autostart() {
  local unit="$UNIT_DIR/kagebox-autostart.service"
  case "${1:-status}" in
    on)
      # Linger is the load-bearing bit: without it, --user services die at
      # logout and never start at boot, no matter what is 'enabled'.
      if [ "$(loginctl show-user "$USER" --property=Linger --value 2>/dev/null)" != "yes" ]; then
        loginctl enable-linger "$USER" 2>/dev/null \
          || sudo loginctl enable-linger "$USER" \
          || die "could not enable linger — user services will still die at logout"
      fi
      mkdir -p "$UNIT_DIR"
      sed -e "s|__KAGEBOX_DIR__|${HERE}|g" "$HERE/bridge/kagebox-autostart.service" > "$unit"
      systemctl --user daemon-reload
      systemctl --user enable kagebox-autostart.service >/dev/null 2>&1 \
        || die "could not enable the autostart unit"
      msg "autostart ON — VM + bridge come back after logout and reboot."
      cmd_autostart status ;;
    off)
      systemctl --user disable --now kagebox-autostart.service >/dev/null 2>&1 || true
      rm -f "$unit"; systemctl --user daemon-reload
      msg "autostart OFF (linger left enabled; disable with: loginctl disable-linger $USER)" ;;
    status)
      echo "linger (user services survive logout): $(loginctl show-user "$USER" --property=Linger --value 2>/dev/null || echo unknown)"
      echo "autostart unit:  $(systemctl --user is-enabled kagebox-autostart.service 2>/dev/null || echo 'not installed')"
      echo "bridge:          $(systemctl --user is-enabled kagebox-bridge.service 2>/dev/null || echo '?') / $(systemctl --user is-active kagebox-bridge.service 2>/dev/null || echo '?')"
      # `is-enabled` prints "not-found" AND exits non-zero, so map it explicitly
      # rather than letting both the output and the fallback print.
      local w; w="$(systemctl is-enabled kagebox-warden.service 2>/dev/null || true)"
      echo "warden:          ${w:-unknown}$([ "$w" = not-found ] && echo '  (run: ./kagebox warden setup)')"
      # Containment must survive a reboot, not just a logout (#12).
      local e; e="$(systemctl is-enabled kagebox-egress.service 2>/dev/null || true)"
      echo "egress at boot:  ${e:-unknown}$([ "$e" = not-found ] && echo '  (run: ./kagebox egress on)')"
      echo "multipassd:      $(systemctl is-enabled snap.multipass.multipassd.service 2>/dev/null || echo '?') / $(systemctl is-active snap.multipass.multipassd.service 2>/dev/null || echo '?')" ;;
    *) echo "usage: kagebox autostart {on|off|status}" ;;
  esac
}

cmd_telegram() {
  vm_exists || die "VM not up; run ./kagebox up"
  cat <<'INTRO'
Telegram gateway setup. First, in the Telegram app:
  1. Message @BotFather   -> /newbot -> copy the BOT TOKEN (like 123456:ABC-...)
  2. Message @userinfobot -> copy your numeric USER ID (a number like 123456789,
     NOT an @username — a username silently denies every message)
INTRO
  local TG_TOKEN TG_USERS
  read -rsp "Paste the Telegram BOT TOKEN: " TG_TOKEN; echo
  read -rp  "Your Telegram user ID(s), comma-separated (NUMERIC): " TG_USERS
  [ -n "$TG_TOKEN" ] && [ -n "$TG_USERS" ] || die "both the token and your user id are required"
  # Telegram user IDs are numbers. Reject @usernames / other text up front — a
  # non-numeric allowlist silently denies every message, which reads as a dead
  # bot with no error (exactly the trap that bit the first setup).
  case "$TG_USERS" in
    *[!0-9,\ ]*) die "allowlist must be NUMERIC id(s) from @userinfobot (e.g. 123456789 or 111,222) — got '$TG_USERS'. An @username will not work." ;;
  esac
  # Token shape sanity check (BotFather tokens are <digits>:<rest>); warn, don't block.
  case "$TG_TOKEN" in
    [0-9]*:?*) : ;;
    *) warn "that doesn't look like a BotFather token (expected 123456:ABC...) — continuing anyway" ;;
  esac

  # A contained sandbox drops all egress except the allowlist, so the bot cannot
  # reach Telegram unless api.telegram.org is on it. Add it here so the bot works
  # WITHOUT opening egress wide — the whole point of containment.
  local allow="$HERE/vm/egress-allowlist.txt"
  if [ -f "$allow" ] && ! grep -qE '^[[:space:]]*api\.telegram\.org[[:space:]]*$' "$allow"; then
    printf 'api.telegram.org\n' >> "$allow"
    msg "added api.telegram.org to vm/egress-allowlist.txt (the bot needs it while contained)"
  fi
  # If egress is currently contained, re-apply BEFORE (re)starting the gateway so
  # Telegram is reachable the moment it comes up. Needs sudo; non-fatal.
  if [ -f /etc/cron.d/kagebox-egress ]; then
    msg "re-applying host egress so api.telegram.org resolves into the allowlist (needs sudo)..."
    cmd_egress on || warn "could not re-apply egress — run './kagebox egress on' so the bot can reach Telegram"
  else
    warn "egress is OPEN now; api.telegram.org is already in the allowlist, so the bot keeps working when you later run './kagebox egress on'."
  fi

  msg "Configuring the Telegram gateway inside '$VM_NAME'..."
  # token travels via stdin (a pipe), never in argv/process-list/history
  printf 'TELEGRAM_BOT_TOKEN=%s\nTELEGRAM_ALLOWED_USERS=%s\n' "$TG_TOKEN" "$TG_USERS" \
    | multipass exec "$VM_NAME" -- bash -lc '
        set -u; umask 077
        export XDG_RUNTIME_DIR=/run/user/$(id -u)
        new=$(cat)
        mkdir -p ~/.hermes; touch ~/.hermes/.env
        grep -vE "^(TELEGRAM_BOT_TOKEN|TELEGRAM_ALLOWED_USERS)=" ~/.hermes/.env > ~/.hermes/.env.new || true
        printf "%s\n" "$new" >> ~/.hermes/.env.new
        mv ~/.hermes/.env.new ~/.hermes/.env
        chmod 600 ~/.hermes/.env
        echo "Saved token + allowlist to ~/.hermes/.env (deny-all except your ID)."
        # Install the USER service only if it is missing. NOT "sudo hermes ...":
        # sudo secure_path drops ~/.local/bin, so it fails command-not-found (the
        # original bug). When already installed we skip straight to a restart —
        # the installer prompts on /dev/tty, which only works when you run this
        # from a real terminal (it does), not headless.
        if ! systemctl --user cat hermes-gateway.service >/dev/null 2>&1; then
          echo "installing the gateway user service (first time)..."
          hermes gateway install --start-on-login --no-start-now || \
            echo "!! install did not complete — run: ./kagebox gateway install"
          loginctl enable-linger "$(id -un)" >/dev/null 2>&1 || true
        fi
        # Restart via systemd (Type=simple -> returns immediately) so it re-reads
        # the .env we just wrote. NOT "hermes gateway restart": that wrapper waits
        # for readiness and HANGS when the bot cannot yet reach Telegram.
        systemctl --user restart hermes-gateway.service 2>/dev/null \
          || systemctl --user start hermes-gateway.service 2>/dev/null || true
        sleep 2
        echo "--- gateway: $(systemctl --user is-active hermes-gateway.service 2>/dev/null || echo not-installed) ---"
      '
  # Persist NOW. ./kagebox setup restores ~/.hermes from the last state backup,
  # so without an immediate backup the token is wiped the next time setup runs —
  # which is exactly what happened on the first attempt. This captures it.
  msg "backing up state so the token survives a future ./kagebox setup..."
  cmd_backup >/dev/null 2>&1 || warn "state backup failed — token is set but not mirrored to the host; run './kagebox backup'"
  msg "Done. Message your bot on Telegram; manage it with: ./kagebox gateway {status|restart|stop|run}"
}

cmd_snapshot() {
  vm_exists || die "no VM"
  local name="${1:-}" running=0
  multipass info "$VM_NAME" 2>/dev/null | grep -q "Running" && running=1
  [ "$running" = 1 ] && { msg "stopping VM to snapshot (multipass needs it stopped)..."; multipass stop "$VM_NAME"; }
  if [ -n "$name" ]; then multipass snapshot "$VM_NAME" --name "$name"; else multipass snapshot "$VM_NAME"; fi
  if [ "$running" = 1 ]; then multipass start "$VM_NAME"; ensure_mount; bridge_start >/dev/null 2>&1; fi
  msg "snapshot saved. list: ./kagebox snapshots"
}
cmd_snapshots() { multipass list --snapshots 2>/dev/null || multipass info "$VM_NAME" --snapshots 2>/dev/null; }
cmd_rollback() {
  vm_exists || die "no VM"
  local snap="${1:-}"; [ -n "$snap" ] || die "usage: ./kagebox rollback <snapshot>   (see: ./kagebox snapshots)"
  read -rp "Restore '$VM_NAME' to snapshot '$snap'? Current disk state is LOST. [y/N] " a
  [ "${a:-n}" = y ] || { echo aborted; return 0; }
  multipass stop "$VM_NAME" 2>/dev/null || true
  multipass restore "${VM_NAME}.${snap}" --destructive
  multipass start "$VM_NAME"; ensure_mount; bridge_start >/dev/null 2>&1
  msg "rolled back to '$snap'."
}

cmd_usage() {
  local f="$HERE/audit/usage.jsonl"
  [ -f "$f" ] || { echo "no usage logged yet at $f (make a cloud/claude call first)"; return 0; }
  python3 - "$f" <<'PY'
import sys, json, collections
# rough USD per 1M tokens (input, output) — APPROXIMATE, edit freely. Local ollama = free.
# Prices live in providers.json (one source of truth, shared with the bridge's
# budget enforcement) — these are only the fallback for routes not defined there.
PRICES = {"claude": (3.0, 15.0), "ollama": (0.0, 0.0)}
try:
    import os as _os
    _pj = _os.path.join(_os.path.dirname(_os.path.abspath(sys.argv[1])), "..", "bridge", "providers.json")
    for _n, _p in (json.load(open(_pj)).get("providers") or {}).items():
        _pr = _p.get("price_per_mtok") or {}
        PRICES[_n] = (float(_pr.get("in", 0) or 0), float(_pr.get("out", 0) or 0))
except Exception:
    pass
agg = collections.defaultdict(lambda: [0, 0, 0])
for line in open(sys.argv[1]):
    try: e = json.loads(line)
    except Exception: continue
    k = (e.get("route", "?"), e.get("model", "?"))
    agg[k][0] += e.get("prompt_tokens", 0); agg[k][1] += e.get("completion_tokens", 0); agg[k][2] += 1
print("%-11s %-26s %6s %10s %10s %8s" % ("route", "model", "calls", "in_tok", "out_tok", "~USD"))
ti = to = tc = 0
for (route, model), (i, o, c) in sorted(agg.items()):
    pin, pout = PRICES.get(route, (0, 0)); cost = i/1e6*pin + o/1e6*pout
    ti += i; to += o; tc += cost
    print("%-11s %-26s %6d %10d %10d %8.3f" % (route, model[:26], c, i, o, cost))
print("-" * 74)
print("%-11s %-26s %6s %10d %10d %8.3f" % ("TOTAL", "", "", ti, to, tc))
print("(prices approximate — edit price_per_mtok in bridge/providers.json, which also")
print(" drives the bridge's spend caps; streamed calls without usage aren't counted)")
PY
}

cmd_task() {
  vm_exists || die "run ./kagebox setup first (need a provisioned VM to clone)"
  local prompt="${*:-}"; [ -n "$prompt" ] || die "usage: ./kagebox task \"<prompt>\""
  local clone="${VM_NAME}-task"
  multipass delete --purge "$clone" 2>/dev/null || true
  local running=0; multipass info "$VM_NAME" 2>/dev/null | grep -q "Running" && running=1
  [ "$running" = 1 ] && { msg "stopping $VM_NAME briefly (clone needs it stopped)..."; multipass stop "$VM_NAME"; }
  msg "cloning $VM_NAME -> $clone (throwaway)..."
  multipass clone "$VM_NAME" --name "$clone" || die "clone failed (needs multipass >= 1.15)"
  if [ "$running" = 1 ]; then multipass start "$VM_NAME" >/dev/null 2>&1; ensure_mount; bridge_start >/dev/null 2>&1; fi
  multipass start "$clone"
  [ -n "${SHARE_DIR:-}" ] && multipass mount "$HERE/$SHARE_DIR" "$clone:/home/ubuntu/workspace" 2>/dev/null || true
  # Contain the throwaway with the HOST-enforced allowlist — the clone shares the
  # bridge, so the host table covers it, and its root agent cannot remove it
  # (the in-guest egress-apply.sh below is only defence-in-depth). Host egress is
  # interface-wide, so this contains every VM on the bridge for the run; it is
  # left ON afterwards (the safe direction) — reopen with `./kagebox egress off`.
  #
  # This is the mode most likely to be pointed at untrusted input, so failing to
  # contain it must be fatal, not a warning scrolling past above the agent's
  # output. If the host table cannot be loaded we destroy the clone and refuse
  # to run rather than execute an unreviewed prompt with open internet.
  if [ "${KAGEBOX_TASK_UNCONTAINED:-0}" = 1 ]; then
    warn "KAGEBOX_TASK_UNCONTAINED=1 — running this task with OPEN egress."
  else
    msg "containing the throwaway (host-enforced egress; needs sudo)..."
    if ! cmd_egress on >/dev/null; then
      multipass delete --purge "$clone" 2>/dev/null || true
      die "host egress could not be enabled (sudo declined?) — throwaway destroyed, task NOT run.
    Run './kagebox egress on' once to authorise it, or set KAGEBOX_TASK_UNCONTAINED=1
    to run anyway — only if you trust this prompt and its inputs completely."
    fi
    # Defence-in-depth inside the clone. Best-effort: the host table above is
    # the control, and it is already known to be loaded at this point.
    multipass transfer "$HERE/vm/egress-apply.sh" "$clone:/home/ubuntu/egress-apply.sh" 2>/dev/null || true
    multipass transfer "$HERE/vm/egress-allowlist.txt" "$clone:/home/ubuntu/egress-allowlist.txt" 2>/dev/null || true
    multipass exec "$clone" -- env BRIDGE_PORT="$BRIDGE_PORT" \
      bash /home/ubuntu/egress-apply.sh on >/dev/null 2>&1 || true
  fi
  printf '%s' "$prompt" | multipass exec "$clone" -- bash -c 'cat > ~/task.txt'
  if [ "${KAGEBOX_TASK_UNCONTAINED:-0}" = 1 ]; then
    msg "running task in $clone (EGRESS OPEN; output -> workspace/)..."
  else
    msg "running task in $clone (egress-contained; output -> workspace/)..."
  fi
  multipass exec "$clone" -- bash -lc 'cd ~/workspace 2>/dev/null; export XDG_RUNTIME_DIR=/run/user/$(id -u); hermes -z "$(cat ~/task.txt)" --yolo' 2>&1 | tail -25
  msg "destroying throwaway $clone."
  multipass delete --purge "$clone"
  [ "${KAGEBOX_TASK_UNCONTAINED:-0}" = 1 ] || \
    warn "host egress was left ON (host-enforced; contains ALL VMs on '$BRIDGE_IFACE', including $VM_NAME). Reopen with: ./kagebox egress off"
}

case "${1:-}" in
  setup) cmd_setup ;;
  doctor) cmd_doctor ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  snapshots) cmd_snapshots ;;
  rollback) shift; cmd_rollback "$@" ;;
  usage) cmd_usage ;;
  task) shift; cmd_task "$@" ;;
  providers|backends) cmd_providers ;;
  telegram) cmd_telegram ;;
  gateway) shift; cmd_gateway "$@" ;;
  skills) shift; cmd_skills "$@" ;;
  research) shift; cmd_research "$@" ;;
  warden) shift; cmd_warden "$@" ;;
  autostart) shift; cmd_autostart "$@" ;;
  backup) cmd_backup ;;
  restore) cmd_restore ;;
  egress) shift; cmd_egress "$@" ;;
  audit) shift; cmd_audit "$@" ;;
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  shell) cmd_shell ;;
  model) build_model ;;
  provision) vm_provision; verify ;;
  claude) vm_claude_setup ;;
  backend) vm_backend "${2:-}" ;;
  verify) verify ;;
  destroy) cmd_destroy ;;
  bridge)
    case "${2:-status}" in
      start) bridge_start ;; stop) bridge_stop ;; restart) bridge_restart ;; install) bridge_install ;;
      status) bridge_status ;; log) bridge_log "${3:-40}" ;;
      *) echo "usage: kagebox bridge {start|stop|restart|status|log|install}" ;;
    esac ;;
  ""|help|-h|--help)
    logo
    awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$HERE/kagebox" ;;
  *) die "unknown command '$1' (try: ./kagebox help)" ;;
esac
