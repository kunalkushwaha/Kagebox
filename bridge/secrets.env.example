# Host-side API keys for the bridge gateway.
# Copy to secrets.env and fill in the ones you use. These stay on the HOST and
# are injected by the gateway into upstream requests — they NEVER enter the VM.
#
#   cp bridge/secrets.env.example bridge/secrets.env
#   chmod 600 bridge/secrets.env
#   ./kagebox bridge start          # reload the gateway with the keys
#
# Each key powers a provider in bridge/providers.json. See: ./kagebox providers

# Gemini (free tier) — get a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...

# OpenRouter (many models via one key) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Anthropic API (Claude) — https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
