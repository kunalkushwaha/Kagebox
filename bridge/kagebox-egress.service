[Unit]
Description=Kagebox host egress containment (restore the allowlist at boot)
Documentation=file:__KAGEBOX_DIR__/SECURITY.md
# The whole point of this unit is ORDERING: the nftables table must be in force
# before the sandbox VM can pass a packet. multipassd owns the bridge and starts
# the VMs, so we get in front of it. We do NOT need the bridge interface to
# exist yet — every rule matches on `iifname` (a per-packet name comparison), so
# the table loads now and starts enforcing the moment the interface appears.
Before=snap.multipass.multipassd.service
After=nftables.service
Wants=nftables.service
DefaultDependencies=no
After=sysinit.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=BRIDGE_IFACE=mpqemubr0
Environment=BRIDGE_PORT=18080
Environment=EGRESS_ALLOWFILE=__KAGEBOX_DIR__/vm/egress-allowlist.txt
# Stamped in at install time. Without it a reboot would restore the DEFAULT
# profile rather than the one the operator chose — widening a sealed box.
Environment=EGRESS_PROFILE=__EGRESS_PROFILE__
Environment=EGRESS_PROFILE_DIR=__KAGEBOX_DIR__/vm/profiles
ExecStart=/usr/bin/env bash __KAGEBOX_DIR__/bridge/host-egress.sh boot
# If the table cannot be loaded, this unit fails LOUDLY rather than letting the
# machine come up with a sandbox that believes it is contained.
Restart=no

[Install]
WantedBy=multi-user.target
